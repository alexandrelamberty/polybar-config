#!/usr/bin/env bash
# Select a Polybar theme while retaining its current light/dark mode.

set -euo pipefail

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_file="${POLYBAR_CONFIG_FILE:-$config_home/polybar/config.ini}"
themes_dir="$config_home/polybar/themes"
theme=''

while getopts ':t:h' option; do
    case "$option" in
        t) theme=$OPTARG ;;
        h) printf 'Usage: %s [-t theme]\n' "${0##*/}"; exit 0 ;;
        *) exit 2 ;;
    esac
done

current_theme=$(awk -F ' = ' '/^include-file = .*\/themes\/.*\.ini$/ { print $2; exit }' "$config_file")
case "$current_theme" in *_dark.ini) mode=dark ;; *) mode=light ;; esac
if [[ -z "$theme" ]]; then
    theme=$(find "$themes_dir" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' | sort | fzf --prompt='Polybar theme > ') || exit 0
fi
target_theme=$(find "$themes_dir/$theme" -maxdepth 1 -type f -name "*_${mode}.ini" -print -quit)
[[ -n "$target_theme" ]] || { printf 'Unknown Polybar theme: %s\n' "$theme" >&2; exit 1; }

temporary_file=$(mktemp "${config_file}.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT
awk -v target="$target_theme" '/^include-file = .*\/themes\/.*\.ini$/ && !updated { print "include-file = " target; updated = 1; next } { print }' "$config_file" > "$temporary_file"
chmod --reference="$config_file" "$temporary_file"
mv "$temporary_file" "$config_file"
command -v polybar-msg >/dev/null && polybar-msg cmd restart >/dev/null 2>&1 || true
