#!/usr/bin/env bash
# Apply a light or dark variant of the active Polybar theme.

set -euo pipefail

config_file="${POLYBAR_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/polybar/config.ini}"
mode="${1:-}"
case "$mode" in light|dark) ;; *) printf 'Usage: %s <light|dark>\n' "${0##*/}" >&2; exit 2 ;; esac

current_theme=$(awk -F ' = ' '/^include-file = .*\/themes\/.*\.ini$/ { print $2; exit }' "$config_file")
target_theme=$(sed -E "s/_(light|dark)\.ini$/_${mode}.ini/" <<<"$current_theme")
[[ -f "$target_theme" ]] || { printf 'Theme variant not found: %s\n' "$target_theme" >&2; exit 1; }

temporary_file=$(mktemp "${config_file}.XXXXXX")
trap 'rm -f "$temporary_file"' EXIT
awk -v target="$target_theme" '/^include-file = .*\/themes\/.*\.ini$/ && !updated { print "include-file = " target; updated = 1; next } { print }' "$config_file" > "$temporary_file"
chmod --reference="$config_file" "$temporary_file"
mv "$temporary_file" "$config_file"
command -v polybar-msg >/dev/null && polybar-msg cmd restart >/dev/null 2>&1 || true
