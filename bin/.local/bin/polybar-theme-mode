#!/usr/bin/env bash
# Change only Polybar's active theme mode.

set -euo pipefail

config_file="${POLYBAR_CONFIG_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/polybar/config.ini}"
current=$(awk -F ' = ' '/^include-file = .*\/themes\/.*\.ini$/ { print $2; exit }' "$config_file")
case "${1:-toggle}" in
  toggle) case "$current" in *_light.ini) mode=dark ;; *_dark.ini) mode=light ;; *) echo 'Cannot determine Polybar theme mode.' >&2; exit 1 ;; esac ;;
  light|dark) mode=$1 ;;
  *) printf 'Usage: %s [toggle|light|dark]\n' "${0##*/}" >&2; exit 2 ;;
esac

target=$(printf '%s\n' "$current" | sed -E "s/_(light|dark)\.ini$/_${mode}.ini/")
[[ -f "$target" ]] || { printf 'Theme variant not found: %s\n' "$target" >&2; exit 1; }
tmp=$(mktemp "${config_file}.XXXXXX")
trap 'rm -f "$tmp"' EXIT
awk -v target="$target" '/^include-file = .*\/themes\/.*\.ini$/ { print "include-file = " target; next } { print }' "$config_file" > "$tmp"
mv "$tmp" "$config_file"
polybar-msg cmd restart >/dev/null 2>&1 || true
printf 'Polybar switched to %s mode\n' "$mode"
